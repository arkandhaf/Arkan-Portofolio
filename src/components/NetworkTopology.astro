---
import { copy as t } from "@/data/portfolioData";
import Localized from "./Localized.astro";
---
<div class="topology-panel"><div class="topology-heading"><span class="micro"><Localized value={t.stack} /></span><span class="micro accent"><i class="status-dot" /><Localized value={t.layers} /></span></div>
    <svg viewBox="0 0 460 380" class="topology" role="img" aria-label={t.topology.en} data-aria-en={t.topology.en} data-aria-id={t.topology.id}>
      <defs><pattern id="dot-grid" width="20" height="20" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="0.7" fill="currentColor" opacity="0.18" /></pattern><linearGradient id="layer-fill" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#62e8ad" stop-opacity="0.13" /><stop offset="1" stop-color="#62e8ad" stop-opacity="0.01" /></linearGradient></defs>
      <rect width="460" height="380" fill="url(#dot-grid)" /><g fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.18"><path d="M230 20V356M25 190H435" /><circle cx="230" cy="190" r="150" stroke-dasharray="3 6" /></g>
      <g class="stack-wire" fill="url(#layer-fill)" stroke="currentColor" stroke-width="1"><path d="M92 243 230 174 368 243 230 312Z" /><path d="M92 243v20l138 69 138-69v-20M230 312v20" /><path d="M92 178 230 109 368 178 230 247Z" /><path d="M92 178v20l138 69 138-69v-20M230 247v20" /><path d="M92 113 230 44 368 113 230 182Z" /><path d="M92 113v20l138 69 138-69v-20M230 182v20" /></g>
      <g stroke="var(--accent)" stroke-width="0.8" fill="none" opacity="0.5"><path d="m142 113 88-44 88 44-88 44Z" /><path d="m171 113 59-29 59 29-59 29Z" /><path d="M230 84v58M171 113h118" /><path d="M142 178 230 134 318 178 230 222Z" stroke-dasharray="3 4" /><path d="M142 243 230 199 318 243 230 287Z" /></g><g fill="var(--accent)"><circle cx="230" cy="113" r="4" /><circle cx="186" cy="178" r="3" /><circle cx="274" cy="178" r="3" /><circle cx="230" cy="243" r="4" /></g><path class="packet-path" d="M230 113v65l44 0-44 65" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-dasharray="8 180" />
      <g class="diagram-label" fill="currentColor"><text x="328" y="60"><tspan data-en="03 / AUTOMATION" data-id="03 / OTOMASI">03 / AUTOMATION</tspan></text><text x="14" y="190">02 / CORE</text><text x="315" y="316"><tspan data-en="01 / PHYSICAL" data-id="01 / FISIK">01 / PHYSICAL</tspan></text></g><g stroke="currentColor" opacity="0.35" fill="none"><path d="M321 65h-16l-25 13M81 186h21l22 11M310 310h-16l-18-9" /></g><text x="230" y="365" text-anchor="middle" class="diagram-label" fill="currentColor"><tspan data-en={t.topology.en} data-id={t.topology.id}>{t.topology.en}</tspan></text>
    </svg><div class="topology-footer micro"><span><Localized value={t.illustrative} /></span><span class="crosshair">+</span></div></div>

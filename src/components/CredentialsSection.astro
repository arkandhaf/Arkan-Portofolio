---
import { Award, BadgeCheck, ArrowUpRight } from "lucide-react";
import { copy as t, credentials } from "@/data/portfolioData";
import AssetFrame from "./AssetFrame.astro";
import Reveal from "./Reveal.astro";
import Localized from "./Localized.astro";
const icons = [BadgeCheck, Award];
---
<section class="section-shell content-section credentials-section">
  <div class="section-kicker"><span class="micro">03 / <Localized value={t.credentials} /></span><span class="micro muted"><Localized value={t.iterate} /></span></div>
  <Reveal><h2 class="section-title"><Localized value={t.credentialsTitle} /></h2><p class="credentials-subtitle"><Localized value={t.credentialsSubtitle} /></p></Reveal>
  <div class="credential-grid">{credentials.map((item, index) => { const Icon = icons[index]; return <Reveal class="credential-card">
    <a class="credential-preview-link" href={item.source} target="_blank" rel="noopener noreferrer" aria-label={item.sourceLabel.en} data-aria-en={item.sourceLabel.en} data-aria-id={item.sourceLabel.id}>
      <AssetFrame src={item.image} alt={item.title} class={`credential-visual ${index === 0 ? "certificate-preview" : "award-preview"}`}><span class="credential-mark"><Icon size={37} strokeWidth={1} /></span><span class="credential-visual-number micro">{item.number} / {String(credentials.length).padStart(2, "0")}</span><span class="certificate-lines" aria-hidden="true"><i></i><i></i><i></i></span></AssetFrame>
    </a>
    <div class="credential-info"><span class="micro accent"><Localized value={item.type} /></span><h3><Localized value={item.title} /></h3><p>{typeof item.issuer === "string" ? item.issuer : <Localized value={item.issuer} />}</p><span class="credential-detail">{typeof item.detail === "string" ? item.detail : <Localized value={item.detail} />}</span><a class="credential-source" href={item.source} target="_blank" rel="noopener noreferrer"><Localized value={item.sourceLabel} /><ArrowUpRight size={14} /></a></div>
  </Reveal>; })}</div>
</section>
